{
  "name": "wmf-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Server application for Winnipeg Music Festival online forms",
  "license": "UNLICENSED",
  "author": "David Sawatzky",
  "type": "module",
  "scripts": {
    "migrate:dev": "dotenvx run --env-file=.env.development -- prisma migrate dev",
    "seed:dev": "dotenvx run --env-file=.env.development -- prisma db seed",
    "prebuild": "rimraf dist",
    "generate:metadata": "nest build --type-check && node ./sanitize-graphql-metadata.mjs",
    "build": "prisma generate && pnpm run generate:metadata && nest build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prisma:generate": "prisma generate --watch",
    "start": "node dist/main",
    "prestart:dev": "pnpm run generate:metadata",
    "start:dev": "dotenvx run --env-file=.env.development -- nest start --watch",
    "start:test": "dotenvx run --env-file=.env.test -- concurrently \"nest start --watch -b swc --type-check\" \"$HOME/go/bin/MailHog\"",
    "start:swc": "dotenvx run --env-file=.env.development -- concurrently \"nest start --watch -b swc --type-check\" \"$HOME/go/bin/MailHog\"",
    "start:debug": "dotenvx run --env-file=.env.development -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --fix",
    "test": "dotenvx run --env-file=.env.test -- vitest run",
    "test:watch": "dotenvx run --env-file=.env.test -- vitest",
    "test:coverage": "dotenvx run --env-file=.env.test -- vitest run --coverage",
    "test:ui": "dotenvx run --env-file=.env.test -- vitest --ui",
    "test:e2e": "dotenvx run --env-file=.env.test -- vitest run --config ./vitest.config.e2e.mts",
    "test:e2e:watch": "dotenvx run --env-file=.env.test -- vitest --config ./vitest.config.e2e.mts",
    "test:e2e:ui": "dotenvx run --env-file=.env.test -- vitest --ui --config ./vitest.config.e2e.mts",
    "types": "ts-node ./src/generate-typings"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@casl/ability": "^7.0.1",
    "@casl/prisma": "^2.0.2",
    "@dotenvx/dotenvx": "^2.23.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/devtools-integration": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@sentry/nestjs": "^10.74.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "mjml": "^5.4.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "prisma-graphql-type-decimal": "^4.0.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "serverless-http": "^4.0.0",
    "stripe": "^22.6.2",
    "ts-node-dev": "^2.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "supertest-graphql": "^1.1.4",
    "ts-loader": "^9.6.2",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "5.0.0"
  }
}
